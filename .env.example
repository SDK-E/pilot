# WorkOS development environment; never commit real credentials.
WORKOS_API_KEY=sk_test_replace_me
WORKOS_CLIENT_ID=client_replace_me
WORKOS_COOKIE_PASSWORD=replace_with_a_random_secret_of_at_least_32_characters
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# Protected pilot-ai Conversation runtime. Pilot forwards a short-lived WorkOS
# M2M token; never add a long-lived bypass secret here.
PILOT_AI_RUNTIME_URL=https://ai.pilot.sdk.enterprises

# WorkOS M2M application Pilot authenticates as (client_credentials grant),
# from the same WorkOS environment as WORKOS_API_KEY above. The domain and
# client ID aren't secret; never commit the client secret.
WORKOS_M2M_AUTHKIT_DOMAIN=https://modern-technology-87-local.authkit.app
WORKOS_M2M_CLIENT_ID=client_01M2GTBXNA4VZ2ZAGD5VB0Q1CB
WORKOS_M2M_CLIENT_SECRET=replace_with_the_local_m2m_client_secret

# Web search and the code sandbox are enabled per-organization from Settings
# (organization_preferences), not an environment variable.

# Encrypts connector OAuth tokens at rest (AES-256-GCM). 32 raw bytes,
# base64-encoded — e.g. `openssl rand -base64 32`. Never reuse across
# environments.
CONNECTOR_TOKEN_ENCRYPTION_KEY=replace_with_a_base64_32_byte_key

# Signs the connector OAuth `state` parameter (HMAC-SHA256) so a callback
# can be verified as one Pilot itself started, within its 10-minute window.
CONNECTOR_STATE_SIGNING_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# GitHub OAuth app credentials for the GitHub connector.
CONNECTOR_GITHUB_CLIENT_ID=replace_me
CONNECTOR_GITHUB_CLIENT_SECRET=replace_me

# Google OAuth client credentials for the Gmail/Google Drive connector.
CONNECTOR_GOOGLE_CLIENT_ID=replace_me
CONNECTOR_GOOGLE_CLIENT_SECRET=replace_me

# Slack app credentials for the Slack connector.
CONNECTOR_SLACK_CLIENT_ID=replace_me
CONNECTOR_SLACK_CLIENT_SECRET=replace_me

# Notion integration credentials for the Notion connector.
CONNECTOR_NOTION_CLIENT_ID=replace_me
CONNECTOR_NOTION_CLIENT_SECRET=replace_me

# Linear OAuth application credentials for the Linear connector.
CONNECTOR_LINEAR_CLIENT_ID=replace_me
CONNECTOR_LINEAR_CLIENT_SECRET=replace_me

# Vercel integration credentials for the Vercel connector.
CONNECTOR_VERCEL_CLIENT_ID=replace_me
CONNECTOR_VERCEL_CLIENT_SECRET=replace_me

# monday.com OAuth application credentials for the Monday connector.
CONNECTOR_MONDAY_CLIENT_ID=replace_me
CONNECTOR_MONDAY_CLIENT_SECRET=replace_me
