# WorkOS development environment; never commit real credentials.
WORKOS_API_KEY=sk_test_replace_me
WORKOS_CLIENT_ID=client_replace_me
WORKOS_COOKIE_PASSWORD=replace_with_a_random_secret_of_at_least_32_characters
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# Protected pilot-ai Conversation runtime. Pilot forwards a short-lived WorkOS
# M2M token; never add a long-lived bypass secret here.
PILOT_AI_RUNTIME_URL=https://ai.pilot.sdk.enterprises

# WorkOS M2M application Pilot authenticates as (client_credentials grant),
# from the same WorkOS environment as WORKOS_API_KEY above. The domain and
# client ID aren't secret; never commit the client secret.
WORKOS_M2M_AUTHKIT_DOMAIN=https://modern-technology-87-local.authkit.app
WORKOS_M2M_CLIENT_ID=client_01M2GTBXNA4VZ2ZAGD5VB0Q1CB
WORKOS_M2M_CLIENT_SECRET=replace_with_the_local_m2m_client_secret

# Web search and the code sandbox are enabled per-organization from Settings
# (organization_preferences), not an environment variable.
