{
  "name": "pilot",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next typegen && eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:migrate:deploy": "tsx scripts/migrate.mts",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:reset": "dotenv -e .env.local -- tsx scripts/db-reset.mts",
    "admin:bootstrap": "dotenv -e .env.local -- tsx scripts/bootstrap-platform-admin.mts",
    "docs:search": "bash scripts/docs-search.sh",
    "graph": "tsx scripts/code-graph.mts",
    "test": "playwright test",
    "test:server": "NODE_OPTIONS='--conditions=react-server' dotenv -e .env.local -- tsx --test 'server-tests/**/*.test.ts' 'src/ai/**/*.test.ts' 'tests/unit/**/*.test.ts'",
    "test:db": "NODE_OPTIONS='--conditions=react-server' dotenv -e .env.local -- tsx --test 'tests/integration/**/*.test.ts'",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm knip",
    "env:pull": "bash scripts/pull-env.sh .env.local development",
    "env:pull:preview": "bash scripts/pull-env.sh .env.local preview",
    "env:pull:production": "bash scripts/pull-env.sh .env.local production",
    "env:push": "bash scripts/push-env.sh .env.local development",
    "env:push:preview": "bash scripts/push-env.sh .env.local preview",
    "env:push:production": "bash scripts/push-env.sh .env.local production",
    "env:sync": "bash scripts/sync-env.sh .env.local development",
    "env:sync:preview": "bash scripts/sync-env.sh .env.local preview",
    "env:sync:production": "bash scripts/sync-env.sh .env.local production",
    "env:check": "bash scripts/check-env.sh development .env.local",
    "env:check:preview": "bash scripts/check-env.sh preview",
    "env:check:production": "bash scripts/check-env.sh production",
    "deploy": "vercel deploy",
    "deploy:production": "vercel deploy --prod",
    "redeploy": "vercel redeploy",
    "redeploy:preview": "vercel redeploy --target preview",
    "redeploy:production": "vercel redeploy --target production",
    "deploy:clean": "bash scripts/clean-deployments.sh preview",
    "deploy:clean:production": "bash scripts/clean-deployments.sh production"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@react-pdf/renderer": "^4.9.0",
    "@remixicon/react": "^4.9.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@vercel/blob": "^2.8.0",
    "@vercel/oidc": "^3.8.8",
    "@workos-inc/authkit-nextjs": "4.3.1",
    "@workos-inc/node": "10.13.0",
    "ai": "^7.0.93",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.12",
    "lucide-react": "^1.40.0",
    "mammoth": "1.12.2",
    "motion": "^13.3.0",
    "nanoid": "^6.0.1",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.12.4",
    "server-only": "0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "1.8.1",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "11.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^10.10.0",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "knip": "6.34.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0"
  },
  "packageManager": "pnpm@11.25.0"
}
