{
  "name": "pilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "test": "playwright test",
    "test:server": "NODE_OPTIONS='--conditions=react-server' dotenv -e .env.local -- tsx --test server-tests/pilot-ai-stream.test.ts src/ai/pilot-runtime-oidc.test.ts tests/stream-contract.test.ts tests/budget-race.integration.test.ts tests/approval-types.test.ts tests/policy-classes.test.ts tests/attachment-text-extraction.test.ts tests/message-submit-shortcut.test.ts tests/research-availability.test.ts tests/research-tool-authorization.test.ts tests/persona-instructions.test.ts tests/duplicate-persona-name.test.ts tests/revocation.integration.test.ts tests/lifecycle-repository.integration.test.ts tests/persona-archive.integration.test.ts tests/workspace-private-search.integration.test.ts",
    "test:db": "NODE_OPTIONS='--conditions=react-server' dotenv -e .env.local -- tsx --test tests/worker-repository.integration.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm knip"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.96",
    "@neondatabase/serverless": "1.1.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@vercel/blob": "^2.8.0",
    "@vercel/oidc": "3.8.5",
    "@workos-inc/authkit-nextjs": "4.3.1",
    "@workos-inc/node": "10.13.0",
    "ai": "^7.0.93",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.12",
    "lucide-react": "^1.40.0",
    "mammoth": "1.12.2",
    "nanoid": "^6.0.1",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "shadcn": "^4.21.0",
    "streamdown": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "1.8.1",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "11.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "knip": "6.34.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.25.0"
}
